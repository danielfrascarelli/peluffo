{
  "name": "peluffo",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0 --report-unused-disable-directives",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "security": "pnpm audit --audit-level=high && gitleaks detect --source . --redact",
    "hooks:install": "./.standards/scripts/hooks/install.sh"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.15.2",
    "tailwind-merge": "3.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.1.12",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "10.13.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "26.1.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.1.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "6.4.4",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.26.1",
  "pnpm": {
    "overrides": {
      "tinypool": "2.1.2"
    }
  }
}
